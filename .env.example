# ============================================================================
# SVL PYTHON OS — DEBIAN 13 TRIXIE & OPEN WEBUI ENVIRONMENT CONFIGURATION
# ============================================================================

# SVL_OPERATOR_TOKEN: Minimum 32-character cryptographic secret for backend RBAC
# Used to authorize protected variable updates, Polkit/sudo terminal actions, and kernel mutations.
# When unset in development, the Python Kernel generates an ephemeral >=48-char session token at boot.
SVL_OPERATOR_TOKEN=""

# OpenSSH Host alias configured for the manual SSH terminal (for example, in ~/.ssh/config)
SVL_SSH_TARGET="Ship"

# GEMINI_API_KEY: Server-side API key for multimodal AI & Vision fallback
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public or local URL of the running application instance
APP_URL="http://localhost:3000"
SVL_BIND_HOST="127.0.0.1"

# OLLAMA_HOST: Local or networked Ollama engine endpoint (built-in daemon listens on 127.0.0.1:11434)
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_PREFERRED_MODEL="llama3.2-vision:11b"
OLLAMA_FALLBACK_VISION_MODEL="qwen2.5-coder:14b"
SVL_AI_MODEL_DIR="/opt/svl-ai-models"
COMFYUI_MODELS_PATH="/opt/svl-comfyui/models"
COMFYUI_HOST="http://127.0.0.1:8188"
# Keep ComfyUI as the default. Set to stable-diffusion.cpp after running
# deploy/install-sd-turbo-cpu.sh; generation requires at least 4 GiB free RAM.
SVL_IMAGE_ENGINE="comfyui"
SVL_SD_CPP_BINARY="./data/tools/stable-diffusion.cpp/build/bin/sd-cli"
SVL_SD_CPP_MODEL="./data/models/sd_turbo_q4_0.gguf"

# GITHUB REPOSITORY INTEGRATIONS (read-only probes + explicit file access)
SVL_GITHUB_REPO_SYSTEM="mmitek515-netizen/SVL_System"
SVL_GITHUB_REPO_DEBIAN="mmitek515-netizen/Debian_13"
GITHUB_TOKEN=""
SVL_GITHUB_FILE_BRANCH="svl-sync"
# Ollama agent workers connect to the loopback-only Streamable HTTP MCP endpoint.
SVL_GITHUB_MCP_URL="http://127.0.0.1:3000/mcp/github"

# ORIGINAL AGENTS EXTERNAL API (Optional remote probe for BastillaOS / Debian 13)
SVL_ORIGINAL_AGENTS_URL=""
DEBIAN13_ORIGINAL_AGENTS_TOKEN=""

# DATABASE & PERSISTENCE (relative paths resolve from the repository root)
SVL_SQLITE_PATH="./data/svl_os.sqlite3"
SVL_PYTHON_PORT="8085"
