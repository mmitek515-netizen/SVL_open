# ============================================================================
# SVL PYTHON OS — DEBIAN 13 TRIXIE & OPEN WEBUI ENVIRONMENT CONFIGURATION
# ============================================================================

# SVL_OPERATOR_TOKEN: Minimum 32-character cryptographic secret for backend RBAC
# Used to authorize protected variable updates, Polkit/sudo terminal actions, and kernel mutations.
# When unset in development, the Python Kernel generates an ephemeral >=48-char session token at boot.
SVL_OPERATOR_TOKEN=""

# GEMINI_API_KEY: Server-side API key for fallback multimodal AI & Vision when local Ollama is offline
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public or local URL of the running application instance
APP_URL="http://localhost:3000"

# OLLAMA_HOST: Local or networked Ollama engine endpoint
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_PREFERRED_MODEL="llama3.2-vision:11b"
OLLAMA_FALLBACK_VISION_MODEL="qwen2.5vl:14b"
# Set to qwen3.8-27b-q5 after running deploy/install-ai-engines.sh on the GPU host.
SVL_AI_MODEL_DIR="/opt/svl-ai-models"
COMFYUI_MODELS_PATH="/opt/svl-comfyui/models"
# Native install default; Docker Compose uses the internal http://comfyui:8188 service.
COMFYUI_HOST="http://127.0.0.1:8188"

# GITHUB REPOSITORY INTEGRATIONS (read-only probes + automatic code sync on a dedicated branch)
SVL_GITHUB_REPO_SYSTEM="mmitek515-netizen/SVL_System"
SVL_GITHUB_REPO_DEBIAN="mmitek515-netizen/Debian_13"
# Server-only fine-grained token; grant Contents read/write only for SVL_open. Never expose to the browser.
# Chat and the deployment dashboard use this token; sync publishes to svl-sync, not directly to main.
# Automatic sync starts after this token is configured and the server is restarted.
GITHUB_TOKEN=""
SVL_GITHUB_SYNC_BRANCH="svl-sync"
SVL_GITHUB_AUTO_SYNC="true"
SVL_GITHUB_SYNC_INTERVAL_MS="30000"

# ORIGINAL AGENTS EXTERNAL API (Optional remote probe for BastillaOS / Debian 13)
SVL_ORIGINAL_AGENTS_URL=""
DEBIAN13_ORIGINAL_AGENTS_TOKEN=""

# OPENAI CODEX CLI CONFIGURATION
# Note: ChatGPT Plus/Pro/Team login uses `codex login --device` (OAuth) and does NOT grant paid OpenAI API key quota.
OPENAI_API_KEY=""
CODEX_HOME="/var/lib/svl-os/codex"

# DATABASE & PERSISTENCE (relative paths resolve from the repository root)
SVL_SQLITE_PATH="./data/svl_os.sqlite3"
SVL_PYTHON_PORT="8085"
