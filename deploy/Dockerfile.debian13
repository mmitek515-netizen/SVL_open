FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    SVL_PYTHON_PORT=8085

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    sqlite3 \
    curl \
    git \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/svl-python-os
COPY backend/ ./backend/
RUN python3 -m venv /opt/svl-python-os/venv && \
    /opt/svl-python-os/venv/bin/pip install --no-cache-dir -r backend/requirements.txt

RUN useradd --system --create-home --home-dir /var/lib/svl-os svlos && \
    chown -R svlos:svlos /opt/svl-python-os /var/lib/svl-os

USER svlos
EXPOSE 8085
CMD ["/opt/svl-python-os/venv/bin/uvicorn", "backend.app:fastapi_app", "--host", "0.0.0.0", "--port", "8085"]
